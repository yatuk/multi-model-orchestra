+_KEYWORDS = {"and", "or", "not", "true", "false", "null"}
+_IDSTART = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_"
+_IDCHARS = _IDSTART + "0123456789"
+_DIGITS = "0123456789"
+
+
+def _tokenize(text):
+    """Return a list of (kind, value, pos). A tokenizer failure is stored as
+    an ("error", ParseError, pos) token so the parser reports whichever
+    problem comes first."""
+    toks = []
+    n = len(text)
+    i = 0
+    while i < n:
+        c = text[i]
+        if c in " \t\r\n\f\v":
+            i += 1
+        elif c == "(":
+            toks.append(("lparen", c, i))
+            i += 1
+        elif c == ")":
+            toks.append(("rparen", c, i))
+            i += 1
+        elif c in _IDSTART:
+            start = i
+            while True:
+                j = i + 1
+                while j < n and text[j] in _IDCHARS:
+                    j += 1
+                i = j
+                if i + 1 < n and text[i] == "." and text[i + 1] in _IDSTART:
+                    i += 1
+                    continue
+                break
+            toks.append(("ident", text[start:i], start))
+        elif c in "<>!=":
+            if text.startswith(("<=", ">=", "!="), i):
+                toks.append(("op", text[i:i + 2], i))
+                i += 2
+            elif c == "!":
+                toks.append(("error", ParseError("unexpected '!'", i), i))
+                return toks
+            else:
+                toks.append(("op", c, i))
+                i += 1
+        elif c == "-" or c in _DIGITS:
+            start = i
+            if c == "-":
+                i += 1
+                if i >= n or text[i] not in _DIGITS:
+                    toks.append(("error", ParseError("'-' must be followed by a digit", start), start))
+                    return toks
+            while i < n and text[i] in _DIGITS:
+                i += 1
+            toks.append(("int", int(text[start:i]), start))
+        elif c == '"':
+            start = i
+            i += 1
+            buf = []
+            while True:
+                if i >= n:
+                    toks.append(("error", ParseError("unterminated string", start), start))
+                    return toks
+                ch = text[i]
+                if ch == '"':
+                    i += 1
+                    break
+                if ch == "\\":
+                    if i + 1 < n and text[i + 1] in '"\\':
+                        buf.append(text[i + 1])
+                        i += 2
+                        continue
+                    toks.append(("error", ParseError("invalid escape in string", start), start))
+                    return toks
+                buf.append(ch)
+                i += 1
+            toks.append(("str", "".join(buf), start))
+        else:
+            toks.append(("error", ParseError(f"unexpected character {c!r}", i), i))
+            return toks
+    toks.append(("eof", None, n))
+    return toks
+
+
+class _Parser:
+    def __init__(self, text):
+        self.text = text
+        self.toks = _tokenize(text)
+        self.i = 0
+
+    def peek(self):
+        tok = self.toks[self.i]
+        if tok[0] == "error":
+            raise tok[1]
+        return tok
+
+    def next(self):
+        tok = self.peek()
+        self.i += 1
+        return tok
+
+    def fail(self, tok, what):
+        if tok[0] == "eof":
+            raise ParseError(f"unexpected end of input, expected {what}", len(self.text))
+        raise ParseError(f"unexpected token, expected {what}", tok[2])
+
+    def is_kw(self, tok, word):
+        return tok[0] == "ident" and tok[1].lower() == word
+
+    def expr(self):
+        left = self.and_expr()
+        while self.is_kw(self.peek(), "or"):
+            self.next()
+            left = ("or", left, self.and_expr())
+        return left
+
+    def and_expr(self):
+        left = self.not_expr()
+        while self.is_kw(self.peek(), "and"):
+            self.next()
+            left = ("and", left, self.not_expr())
+        return left
+
+    def not_expr(self):
+        if self.is_kw(self.peek(), "not"):
+            self.next()
+            return ("not", self.not_expr())
+        return self.primary()
+
+    def primary(self):
+        tok = self.peek()
+        if tok[0] == "lparen":
+            self.next()
+            node = self.expr()
+            close = self.peek()
+            if close[0] != "rparen":
+                self.fail(close, "')'")
+            self.next()
+            return node
+        if tok[0] == "ident" and tok[1].lower() not in _KEYWORDS:
+            self.next()
+            op = self.peek()
+            if op[0] != "op":
+                self.fail(op, "operator")
+            self.next()
+            val = self.peek()
+            if val[0] in ("int", "str"):
+                self.next()
+                return ("cmp", tok[1], op[1], val[1])
+            if val[0] == "ident":
+                low = val[1].lower()
+                if low in ("true", "false", "null"):
+                    self.next()
+                    return ("cmp", tok[1], op[1], {"true": True, "false": False, "null": None}[low])
+            self.fail(val, "value")
+        self.fail(tok, "field or '('")
+
+    def parse(self):
+        node = self.expr()
+        tok = self.peek()
+        if tok[0] != "eof":
+            self.fail(tok, "end of input")
+        return node
+
+
 def parse(text):
-    raise NotImplementedError
+    return _Parser(text).parse()
+
+
+_MISSING = object()
+
+
+def _lookup(record, field):
+    cur = record
+    for part in field.split("."):
+        if not isinstance(cur, dict) or part not in cur:
+            return _MISSING
+        cur = cur[part]
+    return cur
+
+
+def _compare(a, op, b):
+    if op == "=":
+        return a == b
+    if op == "!=":
+        return a != b
+    if op == "<":
+        return a < b
+    if op == "<=":
+        return a <= b
+    if op == ">":
+        return a > b
+    return a >= b
+
+
+def _cmp(record, field, op, value):
+    actual = _lookup(record, field)
+    if actual is _MISSING:
+        return False
+    if value is None:
+        if op == "=":
+            return actual is None
+        if op == "!=":
+            return actual is not None
+        return False
+    if isinstance(value, bool):
+        if isinstance(actual, bool):
+            return op in ("=", "!=") and _compare(actual, op, value)
+        return False
+    if isinstance(actual, bool):
+        return False
+    if isinstance(value, int):
+        if isinstance(actual, (int, float)):
+            return _compare(actual, op, value)
+        return False
+    if isinstance(value, str):
+        if isinstance(actual, str):
+            return _compare(actual, op, value)
+        return False
+    return False
+
+
+def _eval(node, record):
+    kind = node[0]
+    if kind == "cmp":
+        return _cmp(record, node[1], node[2], node[3])
+    if kind == "not":
+        return not _eval(node[1], record)
+    if kind == "and":
+        return _eval(node[1], record) and _eval(node[2], record)
+    return _eval(node[1], record) or _eval(node[2], record)
 
 
