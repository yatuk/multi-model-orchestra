diff --git a/test_report_parts.py b/test_report_parts.py
new file mode 100644
index 0000000..dc225ac
--- /dev/null
+++ b/test_report_parts.py
@@ -0,0 +1,41 @@
+import unittest
+
+from report import format_cents, group_totals, rank, summarize
+
+
+def o(customer, amount, status="paid"):
+    return {"customer": customer, "amount": amount, "status": status}
+
+
+class TestParts(unittest.TestCase):
+    def test_group_totals_cancelled_skipped(self):
+        t = group_totals([o("a", 100), o("b", 50, "cancelled"), o("a", 25, "cancelled")])
+        self.assertEqual(t, {"a": (100, 1)})
+
+    def test_group_totals_refunded(self):
+        t = group_totals([o("a", 100), o("a", 30, "refunded"), o("b", 40, "refunded")])
+        self.assertEqual(t, {"a": (70, 2), "b": (-40, 1)})
+
+    def test_rank_ties(self):
+        t = {"b": (10, 1), "a": (10, 1), "c": (20, 1), "d": (-5, 1)}
+        self.assertEqual(rank(t), ["c", "a", "b", "d"])
+
+    def test_format_cents(self):
+        cases = {-305: "-3.05", 7: "0.07", 0: "0.00", -7: "-0.07", 12345: "123.45"}
+        for cents, text in cases.items():
+            self.assertEqual(format_cents(cents), text)
+
+    def test_summarize_end_to_end(self):
+        orders = [o("bob", 500), o("amy", 500), o("amy", 200, "refunded"),
+                  o("zed", 99, "cancelled"), o("cy", 1000)]
+        self.assertEqual(
+            summarize(orders),
+            "cy: 10.00 (1 orders)\nbob: 5.00 (1 orders)\namy: 3.00 (2 orders)\nTOTAL: 18.00",
+        )
+
+    def test_summarize_empty(self):
+        self.assertEqual(summarize([]), "TOTAL: 0.00")
+
+
+if __name__ == "__main__":
+    unittest.main()
