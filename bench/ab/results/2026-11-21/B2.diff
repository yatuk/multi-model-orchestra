 """A tiny filter language. See TASKS.md, task 4, for the grammar."""
 
+import operator
+
 
 class ParseError(ValueError):
     def __init__(self, message, pos):
@@ -7,9 +9,198 @@ class ParseError(ValueError):
         self.pos = pos
 
 
+_KEYWORDS = {"and", "or", "not", "true", "false", "null"}
+_ID_START = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_"
+_DIGITS = "0123456789"
+_ID_CHARS = _ID_START + _DIGITS
+
+
+def _next_token(text, i):
+    """Return (kind, value, start, end). kinds: EOF ( ) OP FIELD KW INT STR."""
+    n = len(text)
+    while i < n and text[i] in " \t\r\n\f\v":
+        i += 1
+    if i >= n:
+        return ("EOF", None, n, n)
+    c = text[i]
+    start = i
+    if c == "(" or c == ")":
+        return (c, c, start, i + 1)
+    if c in "=!<>":
+        if c != "=" and i + 1 < n and text[i + 1] == "=":
+            return ("OP", c + "=", start, i + 2)
+        if c == "!":
+            raise ParseError("unexpected character '!'", start)
+        return ("OP", c, start, i + 1)
+    if c in _ID_START:
+        j = i + 1
+        while j < n and text[j] in _ID_CHARS:
+            j += 1
+        dotted = False
+        while j < n and text[j] == ".":
+            dotted = True
+            j += 1
+            if j >= n or text[j] not in _ID_START:
+                raise ParseError("expected field name after '.'", j)
+            j += 1
+            while j < n and text[j] in _ID_CHARS:
+                j += 1
+        word = text[start:j]
+        if not dotted and word.lower() in _KEYWORDS:
+            return ("KW", word.lower(), start, j)
+        return ("FIELD", word, start, j)
+    if c in _DIGITS or c == "-":
+        j = i + 1 if c == "-" else i
+        if j >= n or text[j] not in _DIGITS:
+            raise ParseError("expected digits after '-'", start)
+        while j < n and text[j] in _DIGITS:
+            j += 1
+        if j < n and (text[j] in _ID_CHARS or text[j] == "."):
+            raise ParseError("invalid number", j)
+        return ("INT", int(text[start:j]), start, j)
+    if c == '"':
+        j = i + 1
+        buf = []
+        while True:
+            if j >= n:
+                raise ParseError("unterminated string", start)
+            ch = text[j]
+            if ch == '"':
+                return ("STR", "".join(buf), start, j + 1)
+            if ch == "\\":
+                if j + 1 >= n:
+                    raise ParseError("unterminated string", start)
+                nxt = text[j + 1]
+                if nxt == '"' or nxt == "\\":
+                    buf.append(nxt)
+                    j += 2
+                    continue
+                raise ParseError("invalid escape", j)
+            buf.append(ch)
+            j += 1
+    raise ParseError(f"unexpected character {c!r}", start)
+
+
+class _Parser:
+    def __init__(self, text):
+        self.text = text
+        self.tok = _next_token(text, 0)
+
+    def advance(self):
+        t = self.tok
+        if t[0] != "EOF":
+            self.tok = _next_token(self.text, t[3])
+        return t
+
+    def error(self, msg):
+        t = self.tok
+        raise ParseError(msg, len(self.text) if t[0] == "EOF" else t[2])
+
+    def is_kw(self, name):
+        return self.tok[0] == "KW" and self.tok[1] == name
+
+    def parse(self):
+        node = self.or_expr()
+        if self.tok[0] != "EOF":
+            self.error("unexpected token")
+        return node
+
+    def or_expr(self):
+        left = self.and_expr()
+        while self.is_kw("or"):
+            self.advance()
+            left = ("or", left, self.and_expr())
+        return left
+
+    def and_expr(self):
+        left = self.not_expr()
+        while self.is_kw("and"):
+            self.advance()
+            left = ("and", left, self.not_expr())
+        return left
+
+    def not_expr(self):
+        if self.is_kw("not"):
+            self.advance()
+            return ("not", self.not_expr())
+        return self.primary()
+
+    def primary(self):
+        if self.tok[0] == "(":
+            self.advance()
+            node = self.or_expr()
+            if self.tok[0] != ")":
+                self.error("expected ')'")
+            self.advance()
+            return node
+        if self.tok[0] != "FIELD":
+            self.error("expected field or '('")
+        field = self.advance()[1]
+        if self.tok[0] != "OP":
+            self.error("expected operator")
+        op = self.advance()[1]
+        t = self.tok
+        if t[0] in ("INT", "STR"):
+            self.advance()
+            return ("cmp", field, op, t[1])
+        if t[0] == "KW" and t[1] in ("true", "false", "null"):
+            self.advance()
+            return ("cmp", field, op, {"true": True, "false": False, "null": None}[t[1]])
+        self.error("expected value")
+
+
 def parse(text):
-    raise NotImplementedError
+    try:
+        return _Parser(text).parse()
+    except RecursionError:
+        raise ParseError("expression too deeply nested", 0) from None
+
+
+_OPS = {
+    "=": operator.eq, "!=": operator.ne, "<": operator.lt,
+    "<=": operator.le, ">": operator.gt, ">=": operator.ge,
+}
+
+
+def _is_num(v):
+    return isinstance(v, (int, float)) and not isinstance(v, bool)
+
+
+def _cmp(record, field, op, lit):
+    cur = record
+    for part in field.split("."):
+        if not isinstance(cur, dict) or part not in cur:
+            return False
+        cur = cur[part]
+    if lit is None:
+        if op == "=":
+            return cur is None
+        if op == "!=":
+            return cur is not None
+        return False
+    if cur is None:
+        return False
+    if isinstance(lit, bool):
+        if not isinstance(cur, bool):
+            return False
+        return _OPS[op](cur, lit)
+    if _is_num(lit):
+        return _is_num(cur) and _OPS[op](cur, lit)
+    if isinstance(lit, str):
+        return isinstance(cur, str) and _OPS[op](cur, lit)
+    return False
+
+
+def _eval(node, record):
+    kind = node[0]
+    if kind == "cmp":
+        return _cmp(record, node[1], node[2], node[3])
+    if kind == "not":
+        return not _eval(node[1], record)
+    if kind == "and":
+        return _eval(node[1], record) and _eval(node[2], record)
+    return _eval(node[1], record) or _eval(node[2], record)
 
 
 def matches(text, record):
-    raise NotImplementedError
+    return bool(_eval(parse(text), record))
