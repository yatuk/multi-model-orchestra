diff --git a/test_report_parts.py b/test_report_parts.py
new file mode 100644
index 0000000..950a158
--- /dev/null
+++ b/test_report_parts.py
@@ -0,0 +1,48 @@
+import unittest
+
+from report import group_totals, rank, format_cents
+
+
+def order(customer, amount, status="paid"):
+    return {"customer": customer, "amount": amount, "status": status}
+
+
+class TestGroupTotals(unittest.TestCase):
+    def test_cancelled_and_refunded(self):
+        orders = [
+            order("bo", 1000),
+            order("cy", 500, "cancelled"),
+            order("al", 300, "refunded"),
+            order("bo", 250, "shipped"),
+        ]
+        result = group_totals(orders)
+        self.assertEqual(result, {"bo": (1250, 2), "al": (-300, 1)})
+        self.assertEqual(list(result), ["bo", "al"])
+        self.assertIsInstance(result["bo"], tuple)
+        self.assertNotIn("cy", result)
+
+    def test_empty(self):
+        self.assertEqual(group_totals([]), {})
+
+
+class TestRank(unittest.TestCase):
+    def test_order_and_ties(self):
+        totals = {"zed": (500, 1), "bob": (500, 2), "amy": (900, 1), "neg": (-5, 1)}
+        self.assertEqual(rank(totals), ["amy", "bob", "zed", "neg"])
+
+    def test_no_mutation(self):
+        totals = {"b": (1, 1), "a": (2, 1)}
+        rank(totals)
+        self.assertEqual(list(totals), ["b", "a"])
+        self.assertEqual(totals, {"b": (1, 1), "a": (2, 1)})
+
+
+class TestFormatCents(unittest.TestCase):
+    def test_formats(self):
+        cases = {-305: "-3.05", 7: "0.07", 0: "0.00", -7: "-0.07", 123456: "1234.56"}
+        for cents, text in cases.items():
+            self.assertEqual(format_cents(cents), text)
+
+
+if __name__ == "__main__":
+    unittest.main()
