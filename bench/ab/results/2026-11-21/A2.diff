diff --git a/test_report_parts.py b/test_report_parts.py
new file mode 100644
index 0000000..ae7109d
--- /dev/null
+++ b/test_report_parts.py
@@ -0,0 +1,104 @@
+import unittest
+
+from report import format_cents, group_totals, rank, summarize
+
+
+def order(customer, amount, status="paid"):
+    return {"customer": customer, "amount": amount, "status": status}
+
+
+class TestGroupTotals(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(group_totals([]), {})
+
+    def test_paid_refunded_cancelled(self):
+        orders = [
+            order("bo", 1250),
+            order("al", 999),
+            order("bo", 50, "cancelled"),
+            order("al", 300, "refunded"),
+        ]
+        self.assertEqual(group_totals(orders), {"bo": (1250, 1), "al": (699, 2)})
+
+    def test_only_cancelled_customer_is_absent(self):
+        orders = [order("zed", 100, "cancelled"), order("al", 5)]
+        self.assertEqual(group_totals(orders), {"al": (5, 1)})
+
+    def test_refund_only_customer_is_negative_and_counted(self):
+        self.assertEqual(group_totals([order("al", 305, "refunded")]), {"al": (-305, 1)})
+
+    def test_refund_to_zero_keeps_customer(self):
+        orders = [order("al", 100), order("al", 100, "refunded")]
+        self.assertEqual(group_totals(orders), {"al": (0, 2)})
+
+    def test_unknown_status_counts_as_a_sale(self):
+        self.assertEqual(group_totals([order("al", 10, "pending")]), {"al": (10, 1)})
+
+    def test_keeps_first_seen_order(self):
+        orders = [order("c", 1), order("a", 2), order("b", 3), order("a", 4)]
+        self.assertEqual(list(group_totals(orders)), ["c", "a", "b"])
+
+    def test_cancelled_order_needs_only_status(self):
+        self.assertEqual(group_totals([{"status": "cancelled"}]), {})
+
+    def test_missing_key_raises_key_error(self):
+        with self.assertRaises(KeyError):
+            group_totals([{"customer": "al", "amount": 1}])
+
+
+class TestRank(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(rank({}), [])
+
+    def test_net_descending(self):
+        totals = {"al": (5, 1), "bo": (900, 3), "cy": (-20, 1)}
+        self.assertEqual(rank(totals), ["bo", "al", "cy"])
+
+    def test_ties_by_name_ascending(self):
+        totals = {"cy": (10, 1), "al": (10, 9), "bo": (10, 2), "zz": (11, 1)}
+        self.assertEqual(rank(totals), ["zz", "al", "bo", "cy"])
+
+    def test_order_count_does_not_affect_rank(self):
+        self.assertEqual(rank({"b": (1, 99), "a": (2, 1)}), ["a", "b"])
+
+    def test_does_not_mutate_input(self):
+        totals = {"b": (1, 1), "a": (2, 1)}
+        rank(totals)
+        self.assertEqual(list(totals.items()), [("b", (1, 1)), ("a", (2, 1))])
+
+
+class TestFormatCents(unittest.TestCase):
+    def test_spec_examples(self):
+        self.assertEqual(format_cents(-305), "-3.05")
+        self.assertEqual(format_cents(7), "0.07")
+
+    def test_zero_and_small(self):
+        self.assertEqual(format_cents(0), "0.00")
+        self.assertEqual(format_cents(-7), "-0.07")
+        self.assertEqual(format_cents(-1), "-0.01")
+        self.assertEqual(format_cents(99), "0.99")
+
+    def test_whole_and_large(self):
+        self.assertEqual(format_cents(100), "1.00")
+        self.assertEqual(format_cents(-100), "-1.00")
+        self.assertEqual(format_cents(1250), "12.50")
+        self.assertEqual(format_cents(123456789), "1234567.89")
+
+
+class TestSummarizeUsesParts(unittest.TestCase):
+    def test_negative_zero_and_tied_customers(self):
+        orders = [
+            order("cy", 100),
+            order("cy", 100, "refunded"),
+            order("bo", 7, "refunded"),
+            order("al", 0),
+            order("zed", 1, "cancelled"),
+        ]
+        self.assertEqual(
+            summarize(orders),
+            "al: 0.00 (1 orders)\ncy: 0.00 (2 orders)\nbo: -0.07 (1 orders)\nTOTAL: -0.07",
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
