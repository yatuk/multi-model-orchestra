+class _Lexer:
+    """Lazy tokenizer: a token is only scanned when the parser asks for it, so
+    the error that is raised is always the leftmost one.
+
+    Tokens are (kind, pos, value). A malformed string (unterminated or with a
+    bad escape) is reported at its opening quote.
+    """
+
+    def __init__(self, text):
+        self.text = text
+        self.i = 0
+
+    def next(self):
+        text = self.text
+        n = len(text)
+        i = self.i
+        while i < n and text[i].isspace():
+            i += 1
+        if i >= n:
+            self.i = n
+            return ("eof", n, None)
+        start = i
+        ch = text[i]
+
+        if ch == "(" or ch == ")":
+            self.i = i + 1
+            return (ch, start, ch)
+
+        if ch in "=<>!":
+            if ch != "=" and i + 1 < n and text[i + 1] == "=":
+                self.i = i + 2
+                return ("op", start, ch + "=")
+            if ch == "!":
+                raise ParseError("unexpected character '!'", start)
+            self.i = i + 1
+            return ("op", start, ch)
+
+        if ch in _IDENT_START:
+            i += 1
+            while True:
+                while i < n and text[i] in _IDENT_CHARS:
+                    i += 1
+                if i + 1 < n and text[i] == "." and text[i + 1] in _IDENT_START:
+                    i += 2
+                    continue
+                break
+            self.i = i
+            return ("word", start, text[start:i])
+
+        if ch == "-" or ch in _DIGITS:
+            if ch == "-":
+                i += 1
+                if i >= n or text[i] not in _DIGITS:
+                    raise ParseError("'-' must be followed by digits", start)
+            while i < n and text[i] in _DIGITS:
+                i += 1
+            self.i = i
+            return ("int", start, int(text[start:i]))
+
+        if ch == '"':
+            i += 1
+            chars = []
+            while True:
+                if i >= n:
+                    raise ParseError("unterminated string", start)
+                c = text[i]
+                if c == '"':
+                    i += 1
+                    break
+                if c == "\\":
+                    if i + 1 >= n:
+                        raise ParseError("unterminated string", start)
+                    e = text[i + 1]
+                    if e != '"' and e != "\\":
+                        raise ParseError("invalid escape sequence", start)
+                    chars.append(e)
+                    i += 2
+                    continue
+                chars.append(c)
+                i += 1
+            self.i = i
+            return ("str", start, "".join(chars))
+
+        raise ParseError(f"unexpected character {ch!r}", start)
