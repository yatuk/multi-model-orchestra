+
+def _unexpected(tok, expected):
+    kind, pos = tok[0], tok[1]
+    if kind == "eof":
+        return ParseError(f"unexpected end of input, expected {expected}", pos)
+    return ParseError(f"unexpected token, expected {expected}", pos)
