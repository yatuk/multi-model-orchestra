+    kind = tok[0]
+    if kind == "int":
+        value = tok[2]
+    elif kind == "str":
+        value = tok[2]
+    elif kind == "word" and tok[2].lower() in _LITERALS:
+        value = _LITERALS[tok[2].lower()]
+    else:
+        raise _unexpected(tok, "value")
+    return ("cmp", field, op, value)
+
+
+def _reduce(ops, out):
+    op = ops.pop()
+    if op == "not":
+        out.append(("not", out.pop()))
+    else:
+        right = out.pop()
+        left = out.pop()
+        out.append((op, left, right))
+
+
 def parse(text):
-    raise NotImplementedError
+    # Operator-precedence parser with explicit stacks (equivalent to the
+    # recursive-descent grammar, but immune to Python's recursion limit).
+    lexer = _Lexer(text)
+    ops = []  # "(", "not", "and", "or"
+    out = []  # finished nodes
+    want_operand = True
+    while True:
+        tok = lexer.next()
+        kind = tok[0]
+        low = tok[2].lower() if kind == "word" else None
+        if want_operand:
+            if kind == "(":
+                ops.append("(")
+            elif kind == "word" and low == "not":
+                ops.append("not")
+            elif kind == "word" and low not in _LOGIC_KEYWORDS and low not in _LITERALS:
+                out.append(_comparison(lexer, tok[2]))
+                want_operand = False
+            else:
+                raise _unexpected(tok, "field, NOT or '('")
+        else:
+            if kind == "word" and (low == "and" or low == "or"):
+                prec = _PRECEDENCE[low]
+                while ops and ops[-1] != "(" and _PRECEDENCE[ops[-1]] >= prec:
+                    _reduce(ops, out)
+                ops.append(low)
+                want_operand = True
+            elif kind == ")":
+                while ops and ops[-1] != "(":
+                    _reduce(ops, out)
+                if not ops:
+                    raise ParseError("unmatched ')'", tok[1])
+                ops.pop()
+            elif kind == "eof":
+                while ops:
+                    if ops[-1] == "(":
+                        raise ParseError("unexpected end of input, expected ')'", tok[1])
+                    _reduce(ops, out)
+                return out[0]
+            else:
+                raise _unexpected(tok, "AND, OR or end of input")
+
+
+def _lookup(record, field):
+    cur = record
+    for part in field.split("."):
+        if not isinstance(cur, Mapping) or part not in cur:
+            return _MISSING
+        cur = cur[part]
+    return cur
+
+
+def _is_number(x):
+    return isinstance(x, (int, float)) and not isinstance(x, bool)
+
+
+def _compare(record, field, op, value):
+    actual = _lookup(record, field)
+    if actual is _MISSING:
+        return False
+    if value is None:
+        if op == "=":
+            return actual is None
+        if op == "!=":
+            return actual is not None
+        return False
+    if isinstance(value, bool):
+        compatible = isinstance(actual, bool)
+    elif isinstance(value, str):
+        compatible = isinstance(actual, str)
+    else:
+        compatible = _is_number(actual)
+    if not compatible:
+        return False
+    return bool(_OPS[op](actual, value))
+
+
+def _evaluate(ast, record):
+    # Iterative post-order evaluation (no recursion-depth limit).
+    todo = [(ast, False)]
+    results = []
+    while todo:
+        node, visited = todo.pop()
+        tag = node[0]
+        if tag == "cmp":
+            results.append(_compare(record, node[1], node[2], node[3]))
+        elif not visited:
+            todo.append((node, True))
+            for child in node[1:]:
+                todo.append((child, False))
+        elif tag == "not":
+            results.append(not results.pop())
+        else:
+            b = results.pop()
+            a = results.pop()
+            results.append((a and b) if tag == "and" else (a or b))
+    return results[0]
 
 
 def matches(text, record):
-    raise NotImplementedError
+    return _evaluate(parse(text), record)
