diff --git a/test_report_parts.py b/test_report_parts.py
new file mode 100644
index 0000000..bc540ff
--- /dev/null
+++ b/test_report_parts.py
@@ -0,0 +1,83 @@
+import unittest
+
+from report import format_cents, group_totals, rank, summarize
+
+
+def order(customer, amount, status="paid"):
+    return {"customer": customer, "amount": amount, "status": status}
+
+
+class GroupTotalsTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(group_totals([]), {})
+
+    def test_sums_and_counts_per_customer(self):
+        orders = [order("ann", 250), order("bob", 100), order("ann", 50)]
+        self.assertEqual(group_totals(orders), {"ann": (300, 2), "bob": (100, 1)})
+
+    def test_cancelled_orders_are_skipped(self):
+        orders = [order("ann", 250), order("ann", 999, "cancelled"), order("bob", 5, "cancelled")]
+        self.assertEqual(group_totals(orders), {"ann": (250, 1)})
+
+    def test_refunded_orders_subtract_and_still_count(self):
+        orders = [order("ann", 100), order("ann", 405, "refunded"), order("bob", 7, "refunded")]
+        self.assertEqual(group_totals(orders), {"ann": (-305, 2), "bob": (-7, 1)})
+
+    def test_values_are_tuples(self):
+        self.assertIsInstance(group_totals([order("ann", 1)])["ann"], tuple)
+
+
+class RankTest(unittest.TestCase):
+    def test_empty(self):
+        self.assertEqual(rank({}), [])
+
+    def test_net_total_descending(self):
+        totals = {"low": (-5, 1), "high": (900, 1), "mid": (0, 3)}
+        self.assertEqual(rank(totals), ["high", "mid", "low"])
+
+    def test_ties_broken_by_name_ascending(self):
+        totals = {"cy": (100, 1), "bo": (100, 9), "al": (100, 2), "top": (101, 1)}
+        self.assertEqual(rank(totals), ["top", "al", "bo", "cy"])
+
+    def test_order_count_does_not_affect_ranking(self):
+        self.assertEqual(rank({"a": (1, 50), "b": (2, 1)}), ["b", "a"])
+
+
+class FormatCentsTest(unittest.TestCase):
+    def test_spec_examples(self):
+        self.assertEqual(format_cents(-305), "-3.05")
+        self.assertEqual(format_cents(7), "0.07")
+
+    def test_zero_and_small_values(self):
+        self.assertEqual(format_cents(0), "0.00")
+        self.assertEqual(format_cents(-7), "-0.07")
+        self.assertEqual(format_cents(-5), "-0.05")
+        self.assertEqual(format_cents(99), "0.99")
+        self.assertEqual(format_cents(-99), "-0.99")
+
+    def test_whole_and_large_values(self):
+        self.assertEqual(format_cents(100), "1.00")
+        self.assertEqual(format_cents(-100), "-1.00")
+        self.assertEqual(format_cents(123456789), "1234567.89")
+        self.assertEqual(format_cents(-10**12 - 1), "-10000000000.01")
+
+
+class SummarizeUsesPartsTest(unittest.TestCase):
+    def test_summary_matches_helpers(self):
+        orders = [
+            order("bob", 100),
+            order("ann", 100),
+            order("cy", 50, "refunded"),
+            order("dee", 10, "cancelled"),
+        ]
+        self.assertEqual(
+            summarize(orders),
+            "ann: 1.00 (1 orders)\nbob: 1.00 (1 orders)\ncy: -0.50 (1 orders)\nTOTAL: 1.50",
+        )
+
+    def test_empty_summary(self):
+        self.assertEqual(summarize([]), "TOTAL: 0.00")
+
+
+if __name__ == "__main__":
+    unittest.main()
