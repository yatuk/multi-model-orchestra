@@ -7,9 +7,227 @@ class ParseError(ValueError):
         self.pos = pos
 
 
+_IDENT_START = frozenset("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_")
+_DIGITS = frozenset("0123456789")
+_IDENT_CHARS = _IDENT_START | _DIGITS
+_KEYWORDS = {"and": "AND", "or": "OR", "not": "NOT"}
+_LITERALS = {"true": True, "false": False, "null": None}
+_MISSING = object()
+
+
+class _Parser:
+    """Recursive-descent parser over a lazy tokenizer.
+
+    Tokens are produced one at a time, only when the parser needs them, so
+    the error reported is always the first one met reading left to right.
+    A token is a tuple (kind, value, pos) with kind one of:
+    "end", "(", ")", "op", "int", "str", "lit", "ident", "AND", "OR", "NOT".
+    """
+
+    def __init__(self, text):
+        self.text = text
+        self.i = 0
+        self.tok = None
+        self.advance()
+
+    # -- tokenizer ---------------------------------------------------------
+
+    def advance(self):
+        self.tok = self.scan()
+
+    def scan(self):
+        text = self.text
+        n = len(text)
+        i = self.i
+        while i < n and text[i].isspace():
+            i += 1
+        if i >= n:
+            self.i = n
+            return ("end", None, n)
+        start = i
+        ch = text[i]
+
+        if ch == "(" or ch == ")":
+            self.i = i + 1
+            return (ch, ch, start)
+
+        if ch in "<>!=":
+            if ch != "=" and i + 1 < n and text[i + 1] == "=":
+                self.i = i + 2
+                return ("op", ch + "=", start)
+            if ch == "!":
+                raise ParseError("expected '=' after '!'", start)
+            self.i = i + 1
+            return ("op", ch, start)
+
+        if ch in _DIGITS or (ch == "-" and i + 1 < n and text[i + 1] in _DIGITS):
+            i += 1
+            while i < n and text[i] in _DIGITS:
+                i += 1
+            self.i = i
+            return ("int", int(text[start:i]), start)
+
+        if ch == '"':
+            out = []
+            i += 1
+            while i < n:
+                c = text[i]
+                if c == '"':
+                    self.i = i + 1
+                    return ("str", "".join(out), start)
+                if c == "\\" and i + 1 < n and text[i + 1] in '"\\':
+                    out.append(text[i + 1])
+                    i += 2
+                else:
+                    # Any other backslash is kept as a literal backslash.
+                    out.append(c)
+                    i += 1
+            raise ParseError("unterminated string", start)
+
+        if ch in _IDENT_START:
+            i += 1
+            while i < n and text[i] in _IDENT_CHARS:
+                i += 1
+            dotted = False
+            # A dot belongs to the field only when a name starts right after it.
+            while i + 1 < n and text[i] == "." and text[i + 1] in _IDENT_START:
+                dotted = True
+                i += 2
+                while i < n and text[i] in _IDENT_CHARS:
+                    i += 1
+            self.i = i
+            word = text[start:i]
+            if not dotted:
+                low = word.lower()
+                if low in _KEYWORDS:
+                    return (_KEYWORDS[low], word, start)
+                if low in _LITERALS:
+                    return ("lit", _LITERALS[low], start)
+            return ("ident", word, start)
+
+        raise ParseError(f"unexpected character {ch!r}", start)
+
+    # -- grammar -----------------------------------------------------------
+
+    def fail(self, expected):
+        kind, _, pos = self.tok
+        if kind == "end":
+            raise ParseError(f"expected {expected} but input ended", pos)
+        found = self.text[pos:self.i]
+        raise ParseError(f"expected {expected} but found {found!r}", pos)
+
+    def parse(self):
+        node = self.or_expr()
+        if self.tok[0] != "end":
+            self.fail("end of input")
+        return node
+
+    def or_expr(self):
+        node = self.and_expr()
+        while self.tok[0] == "OR":
+            self.advance()
+            node = ("or", node, self.and_expr())
+        return node
+
+    def and_expr(self):
+        node = self.not_expr()
+        while self.tok[0] == "AND":
+            self.advance()
+            node = ("and", node, self.not_expr())
+        return node
+
+    def not_expr(self):
+        depth = 0
+        while self.tok[0] == "NOT":
+            depth += 1
+            self.advance()
+        node = self.primary()
+        for _ in range(depth):
+            node = ("not", node)
+        return node
+
+    def primary(self):
+        kind = self.tok[0]
+        if kind == "(":
+            self.advance()
+            node = self.or_expr()
+            if self.tok[0] != ")":
+                self.fail("')'")
+            self.advance()
+            return node
+        if kind != "ident":
+            self.fail("a field name, NOT or '('")
+        field = self.tok[1]
+        self.advance()
+        if self.tok[0] != "op":
+            self.fail("a comparison operator")
+        op = self.tok[1]
+        self.advance()
+        if self.tok[0] not in ("int", "str", "lit"):
+            self.fail("a value")
+        value = self.tok[1]
+        self.advance()
+        return ("cmp", field, op, value)
+
+
 def parse(text):
-    raise NotImplementedError
+    return _Parser(text).parse()
+
+
+def _lookup(record, field):
+    cur = record
+    for part in field.split("."):
+        if not isinstance(cur, dict) or part not in cur:
+            return _MISSING
+        cur = cur[part]
+    return cur
+
+
+def _is_number(x):
+    return isinstance(x, (int, float)) and not isinstance(x, bool)
+
+
+def _compare(actual, op, value):
+    if actual is _MISSING:
+        return False
+    if value is None:
+        if op == "=":
+            return actual is None
+        if op == "!=":
+            return actual is not None
+        return False
+    if isinstance(value, bool):
+        # Booleans compare only with booleans (false < true).
+        if not isinstance(actual, bool):
+            return False
+    elif isinstance(value, str):
+        if not isinstance(actual, str):
+            return False
+    elif not _is_number(actual):
+        return False
+    if op == "=":
+        return actual == value
+    if op == "!=":
+        return actual != value
+    if op == "<":
+        return actual < value
+    if op == "<=":
+        return actual <= value
+    if op == ">":
+        return actual > value
+    return actual >= value
+
+
+def _evaluate(node, record):
+    tag = node[0]
+    if tag == "cmp":
+        return bool(_compare(_lookup(record, node[1]), node[2], node[3]))
+    if tag == "not":
+        return not _evaluate(node[1], record)
+    if tag == "and":
+        return _evaluate(node[1], record) and _evaluate(node[2], record)
+    return _evaluate(node[1], record) or _evaluate(node[2], record)
 
 
 def matches(text, record):
-    raise NotImplementedError
+    return _evaluate(parse(text), record)
