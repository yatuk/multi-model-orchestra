diff --git a/query.py b/query.py
index 6c0fb9b..8e5ec0b 100644
--- a/query.py
+++ b/query.py
@@ -7,9 +7,220 @@ class ParseError(ValueError):
         self.pos = pos
 
 
+_KEYWORDS = {"and", "or", "not", "true", "false", "null"}
+_LITERALS = {"true": True, "false": False, "null": None}
+_OPS = ("<=", ">=", "!=", "=", "<", ">")
+
+
+def _is_start(c):
+    return ("a" <= c <= "z") or ("A" <= c <= "Z") or c == "_"
+
+
+def _is_part(c):
+    return _is_start(c) or ("0" <= c <= "9")
+
+
+def _tokens(text):
+    """Lazily yield (kind, value, pos); kinds: ( ) op int str ident kw end."""
+    n = len(text)
+    i = 0
+    while True:
+        while i < n and text[i] in " \t\r\n\f\v":
+            i += 1
+        if i >= n:
+            yield ("end", None, n)
+            return
+        c = text[i]
+        if c in "()":
+            yield (c, c, i)
+            i += 1
+        elif c in "=!<>":
+            for op in _OPS:
+                if text.startswith(op, i):
+                    yield ("op", op, i)
+                    i += len(op)
+                    break
+            else:
+                raise ParseError("unexpected character %r" % c, i)
+        elif c == '"':
+            start = i
+            i += 1
+            chars = []
+            while True:
+                if i >= n:
+                    raise ParseError("unterminated string", start)
+                d = text[i]
+                if d == '"':
+                    i += 1
+                    break
+                if d == "\\":
+                    if i + 1 >= n:
+                        raise ParseError("unterminated string", start)
+                    e = text[i + 1]
+                    if e not in '"\\':
+                        raise ParseError("invalid escape", i)
+                    chars.append(e)
+                    i += 2
+                else:
+                    chars.append(d)
+                    i += 1
+            yield ("str", "".join(chars), start)
+        elif c == "-" or ("0" <= c <= "9"):
+            start = i
+            if c == "-":
+                i += 1
+                if i >= n or not ("0" <= text[i] <= "9"):
+                    raise ParseError("'-' must be followed by a digit", start)
+            while i < n and "0" <= text[i] <= "9":
+                i += 1
+            yield ("int", int(text[start:i]), start)
+        elif _is_start(c):
+            start = i
+            while i < n and _is_part(text[i]):
+                i += 1
+            dotted = False
+            while i < n and text[i] == ".":
+                if i + 1 < n and _is_start(text[i + 1]):
+                    dotted = True
+                    i += 1
+                    while i < n and _is_part(text[i]):
+                        i += 1
+                else:
+                    raise ParseError("bad field name", i)
+            word = text[start:i]
+            if not dotted and word.lower() in _KEYWORDS:
+                yield ("kw", word.lower(), start)
+            else:
+                yield ("ident", word, start)
+        else:
+            raise ParseError("unexpected character %r" % c, i)
+
+
+class _Parser:
+    def __init__(self, text):
+        self.text = text
+        self.gen = _tokens(text)
+        self.tok = next(self.gen)
+
+    def advance(self):
+        t = self.tok
+        if t[0] != "end":
+            self.tok = next(self.gen)
+        return t
+
+    def fail(self, what=None):
+        kind, _, pos = self.tok
+        if kind == "end":
+            raise ParseError("unexpected end of input", pos)
+        raise ParseError("unexpected token" + (", expected " + what if what else ""), pos)
+
+    def is_kw(self, word):
+        return self.tok[0] == "kw" and self.tok[1] == word
+
+    def expr(self):
+        node = self.and_expr()
+        while self.is_kw("or"):
+            self.advance()
+            node = ("or", node, self.and_expr())
+        return node
+
+    def and_expr(self):
+        node = self.not_expr()
+        while self.is_kw("and"):
+            self.advance()
+            node = ("and", node, self.not_expr())
+        return node
+
+    def not_expr(self):
+        if self.is_kw("not"):
+            self.advance()
+            return ("not", self.not_expr())
+        return self.primary()
+
+    def primary(self):
+        if self.tok[0] == "(":
+            self.advance()
+            node = self.expr()
+            if self.tok[0] != ")":
+                self.fail("')'")
+            self.advance()
+            return node
+        if self.tok[0] != "ident":
+            self.fail("field")
+        field = self.advance()[1]
+        if self.tok[0] != "op":
+            self.fail("operator")
+        op = self.advance()[1]
+        kind, val, _ = self.tok
+        if kind in ("int", "str"):
+            self.advance()
+            return ("cmp", field, op, val)
+        if kind == "kw" and val in _LITERALS:
+            self.advance()
+            return ("cmp", field, op, _LITERALS[val])
+        self.fail("value")
+
+
 def parse(text):
-    raise NotImplementedError
+    p = _Parser(text)
+    node = p.expr()
+    if p.tok[0] != "end":
+        p.fail("end of input")
+    return node
+
+
+def _is_num(v):
+    return isinstance(v, (int, float)) and not isinstance(v, bool)
+
+
+def _compare(v, op, lit):
+    if lit is None:
+        if op == "=":
+            return v is None
+        if op == "!=":
+            return v is not None
+        return False
+    if v is None:
+        return False
+    if isinstance(v, bool) or isinstance(lit, bool):
+        if not (isinstance(v, bool) and isinstance(lit, bool)):
+            return False
+        if op == "=":
+            return v == lit
+        if op == "!=":
+            return v != lit
+        return False
+    if (_is_num(v) and _is_num(lit)) or (isinstance(v, str) and isinstance(lit, str)):
+        if op == "=":
+            return v == lit
+        if op == "!=":
+            return v != lit
+        if op == "<":
+            return v < lit
+        if op == "<=":
+            return v <= lit
+        if op == ">":
+            return v > lit
+        return v >= lit
+    return False
+
+
+def _eval(node, record):
+    kind = node[0]
+    if kind == "cmp":
+        _, field, op, lit = node
+        v = record
+        for part in field.split("."):
+            if not isinstance(v, dict) or part not in v:
+                return False
+            v = v[part]
+        return _compare(v, op, lit)
+    if kind == "not":
+        return not _eval(node[1], record)
+    if kind == "and":
+        return _eval(node[1], record) and _eval(node[2], record)
+    return _eval(node[1], record) or _eval(node[2], record)
 
 
 def matches(text, record):
-    raise NotImplementedError
+    return _eval(parse(text), record)
