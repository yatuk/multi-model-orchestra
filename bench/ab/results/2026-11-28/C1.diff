diff --git a/test_report_parts.py b/test_report_parts.py
new file mode 100644
index 0000000..ed2ff2b
--- /dev/null
+++ b/test_report_parts.py
@@ -0,0 +1,30 @@
+import unittest
+
+from report import format_cents, group_totals, rank
+
+
+class TestParts(unittest.TestCase):
+    def test_group_totals(self):
+        orders = [
+            {"customer": "a", "amount": 500, "status": "paid"},
+            {"customer": "a", "amount": 200, "status": "refunded"},
+            {"customer": "b", "amount": 900, "status": "cancelled"},
+            {"customer": "c", "amount": 100, "status": "refunded"},
+        ]
+        self.assertEqual(group_totals(orders), {"a": (300, 2), "c": (-100, 1)})
+        self.assertEqual(group_totals([]), {})
+
+    def test_rank(self):
+        totals = {"z": (10, 1), "b": (50, 2), "a": (50, 1), "m": (-5, 1)}
+        self.assertEqual(rank(totals), ["a", "b", "z", "m"])
+        self.assertEqual(rank({}), [])
+
+    def test_format_cents(self):
+        cases = {-305: "-3.05", 7: "0.07", 0: "0.00", -7: "-0.07",
+                 100: "1.00", 123456: "1234.56", -100: "-1.00"}
+        for cents, text in cases.items():
+            self.assertEqual(format_cents(cents), text)
+
+
+if __name__ == "__main__":
+    unittest.main()
