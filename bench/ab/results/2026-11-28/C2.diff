 """A tiny filter language. See TASKS.md, task 4, for the grammar."""
+import operator
+import re
 
 
 class ParseError(ValueError):
@@ -7,9 +9,217 @@ class ParseError(ValueError):
         self.pos = pos
 
 
+_WORD = re.compile(r"[A-Za-z_][A-Za-z0-9_]*(?:\.[A-Za-z_][A-Za-z0-9_]*)*")
+_INT = re.compile(r"-?[0-9]+")
+_OPS = ("<=", ">=", "!=", "<", ">", "=")
+_KEYWORDS = {"and", "or", "not", "true", "false", "null"}
+_LITERALS = {"true": True, "false": False, "null": None}
+
+
+class _Lexer:
+    """Lazy tokenizer: tokens are (kind, value, pos); lexical errors become
+    ("ERR", message, pos) tokens, raised only when the parser reaches them."""
+
+    def __init__(self, text):
+        self.text = text
+        self.i = 0
+        self.tok = None
+
+    def peek(self):
+        if self.tok is None:
+            self.tok = self._scan()
+        return self.tok
+
+    def next(self):
+        tok = self.peek()
+        if tok[0] != "EOF":
+            self.tok = None
+        return tok
+
+    def _scan(self):
+        text, n = self.text, len(self.text)
+        i = self.i
+        while i < n and text[i].isspace():
+            i += 1
+        self.i = i
+        if i >= n:
+            return ("EOF", None, n)
+        c = text[i]
+        if c == "(" or c == ")":
+            self.i = i + 1
+            return (c, c, i)
+        for op in _OPS:
+            if text.startswith(op, i):
+                self.i = i + len(op)
+                return ("OP", op, i)
+        m = _INT.match(text, i)
+        if m:
+            self.i = m.end()
+            return ("INT", int(m.group()), i)
+        m = _WORD.match(text, i)
+        if m:
+            self.i = m.end()
+            return ("WORD", m.group(), i)
+        if c == '"':
+            return self._string(i)
+        self.i = n  # lexical error: nothing meaningful follows
+        return ("ERR", "unexpected character %r" % c, i)
+
+    def _string(self, start):
+        text, n = self.text, len(self.text)
+        j = start + 1
+        out = []
+        while j < n:
+            c = text[j]
+            if c == '"':
+                self.i = j + 1
+                return ("STR", "".join(out), start)
+            if c == "\\":
+                if j + 1 < n and text[j + 1] in '"\\':
+                    out.append(text[j + 1])
+                    j += 2
+                    continue
+                self.i = n
+                return ("ERR", "invalid escape in string", start)
+            out.append(c)
+            j += 1
+        self.i = n
+        return ("ERR", "unterminated string", start)
+
+
+class _Parser:
+    def __init__(self, text):
+        self.lx = _Lexer(text)
+
+    def peek(self):
+        tok = self.lx.peek()
+        if tok[0] == "ERR":
+            raise ParseError(tok[1], tok[2])
+        return tok
+
+    def fail(self, what):
+        tok = self.peek()
+        raise ParseError("expected %s" % what, tok[2])
+
+    def is_kw(self, tok, kw):
+        return tok[0] == "WORD" and tok[1].lower() == kw
+
+    def parse(self):
+        node = self.or_expr()
+        if self.peek()[0] != "EOF":
+            self.fail("end of input")
+        return node
+
+    def or_expr(self):
+        node = self.and_expr()
+        while self.is_kw(self.peek(), "or"):
+            self.lx.next()
+            node = ("or", node, self.and_expr())
+        return node
+
+    def and_expr(self):
+        node = self.not_expr()
+        while self.is_kw(self.peek(), "and"):
+            self.lx.next()
+            node = ("and", node, self.not_expr())
+        return node
+
+    def not_expr(self):
+        if self.is_kw(self.peek(), "not"):
+            self.lx.next()
+            return ("not", self.not_expr())
+        return self.primary()
+
+    def primary(self):
+        tok = self.peek()
+        if tok[0] == "(":
+            self.lx.next()
+            node = self.or_expr()
+            if self.peek()[0] != ")":
+                self.fail("')'")
+            self.lx.next()
+            return node
+        if tok[0] != "WORD" or tok[1].lower() in _KEYWORDS:
+            self.fail("field name or '('")
+        self.lx.next()
+        field = tok[1]
+        op = self.peek()
+        if op[0] != "OP":
+            self.fail("comparison operator")
+        self.lx.next()
+        val = self.peek()
+        if val[0] in ("INT", "STR"):
+            value = val[1]
+        elif val[0] == "WORD" and val[1].lower() in _LITERALS:
+            value = _LITERALS[val[1].lower()]
+        else:
+            self.fail("value")
+        self.lx.next()
+        return ("cmp", field, op[1], value)
+
+
 def parse(text):
-    raise NotImplementedError
+    p = _Parser(text)
+    try:
+        return p.parse()
+    except RecursionError:
+        raise ParseError("expression nested too deeply", p.lx.peek()[2]) from None
+
+
+_CMP = {
+    "=": operator.eq, "!=": operator.ne, "<": operator.lt,
+    "<=": operator.le, ">": operator.gt, ">=": operator.ge,
+}
+_MISSING = object()
+
+
+def _lookup(record, field):
+    cur = record
+    for part in field.split("."):
+        if not isinstance(cur, dict) or part not in cur:
+            return _MISSING
+        cur = cur[part]
+    return cur
+
+
+def _eval_cmp(record, field, op, lit):
+    v = _lookup(record, field)
+    if v is _MISSING:
+        return False
+    if lit is None:
+        if op == "=":
+            return v is None
+        if op == "!=":
+            return v is not None
+        return False
+    if isinstance(lit, bool):
+        return isinstance(v, bool) and op in ("=", "!=") and _CMP[op](v, lit)
+    if isinstance(lit, int):
+        ok = isinstance(v, (int, float)) and not isinstance(v, bool)
+    else:
+        ok = isinstance(v, str)
+    return ok and _CMP[op](v, lit)
+
+
+def _evaluate(node, record):
+    kind = node[0]
+    if kind == "cmp":
+        return _eval_cmp(record, node[1], node[2], node[3])
+    if kind == "not":
+        return not _evaluate(node[1], record)
+    # and/or: walk the left spine iteratively (chains can be very long)
+    rights = []
+    while node[0] == kind:
+        rights.append(node[2])
+        node = node[1]
+    result = _evaluate(node, record)
+    for right in reversed(rights):
+        if kind == "and":
+            result = result and _evaluate(right, record)
+        else:
+            result = result or _evaluate(right, record)
+    return result
 
 
 def matches(text, record):
-    raise NotImplementedError
+    return _evaluate(parse(text), record)
