diff --git a/test_report_parts.py b/test_report_parts.py
new file mode 100644
index 0000000..76d3ef3
--- /dev/null
+++ b/test_report_parts.py
@@ -0,0 +1,31 @@
+import unittest
+
+from report import format_cents, group_totals, rank
+
+
+class ReportPartsTest(unittest.TestCase):
+    def test_group_totals(self):
+        orders = [
+            {"customer": "a", "amount": 500, "status": "paid"},
+            {"customer": "a", "amount": 200, "status": "refunded"},
+            {"customer": "b", "amount": 900, "status": "cancelled"},
+            {"customer": "c", "amount": 50, "status": "refunded"},
+        ]
+        self.assertEqual(group_totals(orders), {"a": (300, 2), "c": (-50, 1)})
+
+    def test_group_totals_empty(self):
+        self.assertEqual(group_totals([]), {})
+
+    def test_rank(self):
+        totals = {"b": (100, 1), "a": (100, 2), "c": (500, 1), "d": (-5, 1)}
+        self.assertEqual(rank(totals), ["c", "a", "b", "d"])
+
+    def test_format_cents(self):
+        self.assertEqual(format_cents(-305), "-3.05")
+        self.assertEqual(format_cents(7), "0.07")
+        self.assertEqual(format_cents(0), "0.00")
+        self.assertEqual(format_cents(12345), "123.45")
+
+
+if __name__ == "__main__":
+    unittest.main()
