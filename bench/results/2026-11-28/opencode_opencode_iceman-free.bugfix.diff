+"""Duration parsing used by the scheduler."""
+
+UNITS = {"h": 3600, "m": 60, "s": 1}
+UNIT_ORDER = {"h": 0, "m": 1, "s": 2}
+
+
+def parse_duration(text):
+    """Return the number of seconds in a duration like "1h30m15s".
+
+    Rules:
+    1. Units are h, m and s. Each unit may appear at most once.
+    2. Units that appear must be in the order h, m, s ("1m1h" is invalid).
+    3. Every number must be followed by a unit ("90" and "1h30" are invalid).
+    4. The empty string is invalid.
+    5. Anything else (spaces, other letters, signs) is invalid.
+    Invalid input raises ValueError.
+    """
+    if text == "":
+        raise ValueError("empty string")
+
+    total = 0
+    num = ""
+    last_order = -1
+    saw_unit = False
+
+    for ch in text:
+        if ch.isdigit():
+            num += ch
+        elif ch in UNITS:
+            if num == "":
+                raise ValueError(f"missing number before {ch!r}")
+            order = UNIT_ORDER[ch]
+            if order <= last_order:
+                raise ValueError(f"bad unit order or duplicate unit {ch!r}")
+            total += int(num) * UNITS[ch]
+            num = ""
+            last_order = order
+            saw_unit = True
+        else:
+            raise ValueError(f"bad character {ch!r}")
+
+    if num != "":
+        raise ValueError("trailing number without unit")
+    if not saw_unit:
+        raise ValueError("no units found")
+
+    return total
