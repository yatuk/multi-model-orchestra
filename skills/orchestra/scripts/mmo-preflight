#!/usr/bin/env bash
# mmo-preflight: offline readiness check. Never signs in, never calls a model.
# Shows which lanes can run on this machine, so the orchestrator routes only to those.
set -u
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ok=0
row() { printf '  %-10s %-8s %s\n' "$1" "$2" "$3"; }

echo "multi-model-orchestra preflight (offline)"
for bin in git timeout; do
  if command -v "$bin" >/dev/null; then row "$bin" ok "$(command -v "$bin")"; else row "$bin" MISSING "required"; ok=1; fi
done
if command -v python3 >/dev/null || command -v python >/dev/null; then row python ok "$( (python3 --version || python --version) 2>&1 | head -1)"
else row python MISSING "required to read lane output"; ok=1; fi

echo "lanes (ok = CLI found, setup = found but not configured, absent = not installed)"
bash "$HERE/mmo-run" --list | sed 's/^/  /'
ready="$(bash "$HERE/mmo-run" --list | awk 'NR>1 && $2=="ok"' | wc -l | tr -d ' ')"
echo "  CHECKED: a date means the lane was run on that day; docs-<version> means it was written from"
echo "  the documentation of that version and never run. Installed does not mean signed in: send a"
echo "  one-line read-only brief through mmo-run before routing real work to a lane."

[ $ok -ne 0 ] && { echo "result: NOT READY (missing a required tool)"; exit 1; }
[ "$ready" -eq 0 ] && { echo "result: READY, but no external lane is installed (sub-agents still work)"; exit 0; }
echo "result: READY, $ready lane(s) installed"
